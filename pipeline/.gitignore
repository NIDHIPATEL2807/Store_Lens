# ── Secrets ────────────────────────────────────────────────────────────────────
.env
.env.*
*.key
secrets.json
credentials.json
groq_api_key.ENV

# ── Python runtime ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environment ─────────────────────────────────────────────────────────
venv/
env/
.venv/

# ── Model weights (large binaries — download at runtime) ───────────────────────
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.pb

# ── VIDEO FILES — never commit (too large) ─────────────────────────────────────
*.mp4
*.mov
*.mkv
*.avi
*.hevc
*.h265
*.ts
*.wmv
*.flv
input/
*/input/

# ── Visualizer output videos (generated, large) ────────────────────────────────
output/viz/

# ── SQLite database (generated from events.jsonl via ingest) ───────────────────
L7_api/data/store.db
L7_api/data/

# ── Auto-backup JSONs from annotation tool ─────────────────────────────────────
*_backup_*.json

# ── OS junk ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Logs ────────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Misc ────────────────────────────────────────────────────────────────────────
*.tmp
*.bak
