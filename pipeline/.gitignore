# ── Video & image inputs (large media — store in cloud / shared drive) ──────────
input/
INPUT/
*/input/
*/INPUT/
*.mp4
*.mov
*.mkv
*.avi
*.hevc
*.h265
*.ts

# ── Pipeline outputs (generated, reproducible — do not commit raw data) ─────────
# output/
# OUTPUT/
# */output/
# */OUTPUT/

# ── Layer-specific generated artefacts ──────────────────────────────────────────
# L1 — extracted frames and viz overlays
*/frames/
*/viz/

# L2 — per-frame JSONL tracks
*.jsonl

# L1 — auto-backup JSONs created by annotate_zones.py
*_backup_*.json

# Layout PNGs inside output (keep only store_layout.json, not raw images)
output/**/*.png
output/**/*.jpg
output/**/*.jpeg

# ── Logs ────────────────────────────────────────────────────────────────────────
*.log
logs/

